# CloudPulse X Configuration

# Cloud Provider Mode: "demo" (Offline Simulator) or "aws" (Live AWS Boto3)
CLOUD_PROVIDER=demo

# Database Configuration (SQLite by default for zero-config run, or PostgreSQL)
DATABASE_URL=sqlite:///./cloudpulse.db
# DATABASE_URL=postgresql://cloudpulse:cloudpulse_secret_2026@localhost:5432/cloudpulse_db

# Security
SECRET_KEY=cloudpulse-x-super-secret-jwt-key-for-dev-2026

# Optional AWS Credentials (for live AWS mode)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Frontend API URL
VITE_API_URL=http://localhost:8000/api
